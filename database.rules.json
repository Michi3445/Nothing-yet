{
  "rules": {
    "pg": {
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4}$/) && newData.child('host').isString() && newData.child('created').isNumber()",
          "song": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists()",
              ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16"
            }
          }
        }
      },
      "media": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('pg/rooms/' + $code + '/host').val() === auth.uid || (!root.child('pg/rooms/' + $code).exists() && !newData.exists()))",
          "data": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 400000"
            }
          }
        }
      }
    },
    "kw": {
      "codes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4}$/) && newData.child('wid').isString() && newData.child('owner').val() === auth.uid"
        }
      },
      "worlds": {
        "$wid": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.child('owner').isString() && newData.child('seed').isNumber() && newData.child('created').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 30"
        }
      },
      "edits": {
        "$wid": {
          ".read": "auth != null",
          "$k": {
            ".write": "auth != null && root.child('kw/worlds/' + $wid + '/owner').exists()",
            ".validate": "$k.matches(/^-?[0-9]{1,8}_[0-9]{1,3}_-?[0-9]{1,8}$/) && newData.isString() && newData.val().length <= 12"
          }
        }
      },
      "players": {
        "$wid": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('kw/worlds/' + $wid + '/owner').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16"
          }
        }
      },
      "saves": {
        "$wid": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('kw/worlds/' + $wid + '/owner').exists()"
          }
        }
      },
      "chat": {
        "$wid": {
          ".read": "auth != null",
          "$m": {
            ".write": "auth != null && !data.exists() && root.child('kw/worlds/' + $wid + '/owner').exists()",
            ".validate": "newData.child('u').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 16 && newData.child('t').isString() && newData.child('t').val().length <= 200"
          }
        }
      },
      "be": {
        "$wid": {
          ".read": "auth != null",
          "$k": {
            ".write": "auth != null && root.child('kw/worlds/' + $wid + '/owner').exists()",
            ".validate": "$k.matches(/^-?[0-9]{1,8}_[0-9]{1,3}_-?[0-9]{1,8}$/) && newData.isString() && newData.val().length <= 1500"
          }
        }
      },
      "locks": {
        "$wid": {
          ".read": "auth != null",
          "$k": {
            ".write": "auth != null && root.child('kw/worlds/' + $wid + '/owner').exists() && (!data.exists() || data.child('u').val() === auth.uid || !root.child('kw/players/' + $wid + '/' + data.child('u').val()).exists())",
            ".validate": "$k.matches(/^-?[0-9]{1,8}_[0-9]{1,3}_-?[0-9]{1,8}$/) && newData.child('u').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 16"
          }
        }
      },
      "items": {
        "$wid": {
          ".read": "auth != null",
          ".indexOn": [
            "ts"
          ],
          "$k": {
            ".write": "auth != null && root.child('kw/worlds/' + $wid + '/owner').exists()",
            ".validate": "newData.child('id').isNumber() && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 64 && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('z').isNumber()"
          }
        }
      },
      "wx": {
        "$wid": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('kw/worlds/' + $wid + '/owner').exists()",
          ".validate": "newData.child('rain').isNumber() && newData.child('th').isNumber() && newData.child('until').isNumber()"
        }
      }
    }
  }
}
